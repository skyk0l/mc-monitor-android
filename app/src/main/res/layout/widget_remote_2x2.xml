<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wDot"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/widget_accent"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/wServerIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_server_icon"
            android:contentDescription="Иконка сервера"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_server_fallback" />

        <TextView
            android:id="@+id/wName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="MC Monitor"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wRefresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Обновить"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/widget_accent"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="@color/widget_text"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/widget_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="нет данных"
            android:textColor="@color/widget_waiting"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        android:background="#337F927E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Версия появится после ответа"
            android:textColor="@color/widget_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/wLastUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ещё не проверяли"
            android:textColor="@color/widget_soft"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
