<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="4dp"
    android:paddingEnd="7dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wServerIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_server_icon"
            android:contentDescription="Иконка сервера"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_server_fallback" />

        <TextView
            android:id="@+id/wName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="MC Monitor"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Обновить"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/widget_accent"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wDot"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/widget_accent"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/wCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="@color/widget_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            android:textColor="@color/widget_dim"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wPlayersEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_soft"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
