<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/server_edition_label"
        android:textColor="@color/soft"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/protocolInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/nameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/server_name_label"
        android:textColor="@color/soft"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/server_name_from_motd_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/addressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/server_address_label_java"
        android:textColor="@color/soft"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/addressInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="@string/server_address_hint_java"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/protocolHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/server_protocol_hint_java"
        android:textColor="@color/dim"
        android:textSize="10sp" />
</LinearLayout>
